# Chỉ đặt bí mật trên máy chủ / bảng Environment của nhà cung cấp hosting.
# Không đặt API key trong public/index.html, admin.html hoặc bất kỳ mã JavaScript trình duyệt nào.
NODE_ENV=development
PORT=3000
KICK_GOLD_API_KEY=REPLACE_WITH_REAL_PROVIDER_SECRET
ADMIN_USER=replace-with-a-private-admin-username
# Tạo mật khẩu ngẫu nhiên dài >= 24 ký tự; không dùng ví dụ này nguyên văn.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD_AT_LEAST_24_CHARS
# Chỉ đặt 1 nếu ứng dụng chạy sau reverse proxy đáng tin cậy đã xử lý HTTPS.
TRUST_PROXY=0
